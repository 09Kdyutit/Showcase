# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Database (server-side only, never expose to client)
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO_MONTHLY=price_...
STRIPE_PRICE_ID_PRO_ANNUAL=price_...
STRIPE_PRICE_ID_FOUNDING_ANNUAL=price_...

# AI Provider (OpenAI) — server-side only, never expose to browser
OPENAI_API_KEY=sk-proj-...

# Model routing (optional — defaults shown below)
# fast tier: resume parsing, bullet improvement, role match, and lightweight analysis
OPENAI_MODEL_FAST=gpt-4o-mini
# main tier: full ProofScore audit, portfolio generation
OPENAI_MODEL_MAIN=gpt-4o
# premium tier: optional final-polish pass only, not used automatically
OPENAI_MODEL_PREMIUM=gpt-4o
# interviewAnalysis tier: post-session interview coaching/evidence assessment
OPENAI_MODEL_INTERVIEW_ANALYSIS=gpt-5-mini

# Versioned token rates used by the general AI cost ledger. Key by the exact configured
# model name (or "*" as an explicit fallback). Keep this synchronized with provider billing;
# runPrompt calls without a configured full/cached/output rate fail closed; rates are never
# guessed. The cost ledger also exposes the rate version used for historical reporting.
# Rates below match OpenAI's published standard token prices on 2026-07-09. Re-verify
# before production deployment; the version is stored on every ledger row.
OPENAI_COST_RATES_JSON={"gpt-4o-mini":{"inputPerMillion":0.15,"cachedInputPerMillion":0.075,"outputPerMillion":0.60,"pricingVersion":"openai-2026-07-09"},"gpt-4o":{"inputPerMillion":2.50,"cachedInputPerMillion":1.25,"outputPerMillion":10.00,"pricingVersion":"openai-2026-07-09"},"gpt-5-mini":{"inputPerMillion":0.25,"cachedInputPerMillion":0.025,"outputPerMillion":2.00,"pricingVersion":"openai-2026-07-09"}}

# Fail-closed atomic USD ceilings for every non-mock runPrompt call. The guard reserves
# worst-case cost before OpenAI is contacted, then settles to provider-reported usage.
# This $4/day + $80/month allocation leaves $1/day + $20/month of the approved overall
# $5/day + $100/month ceiling for Interview Lab's separately guarded provider calls.
OPENAI_GENERAL_DAILY_BUDGET_USD=4
OPENAI_GENERAL_MONTHLY_BUDGET_USD=80

# Hard platform-wide daily counter for OpenAI calls. This bounds request volume, while
# OPENAI_COST_RATES_JSON + the weekly scorecard expose the dollar cost.
AI_GLOBAL_DAILY_LIMIT=2000

# Incident controls. Set one to true without deploying to stop new spend, checkout, job
# provider traffic, or public publishing. Leave false during normal operation.
KILL_SWITCH_AI=false
# Fail-closed until every direct Gemini/Live path uses atomic dollar reservations and
# passes staging concurrency tests. Only the literal value false permits Gemini traffic.
KILL_SWITCH_GEMINI=true
KILL_SWITCH_CHECKOUT=false
KILL_SWITCH_JOBS_PROVIDER=false
KILL_SWITCH_PUBLISHING=false

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional server error sink (Slack-compatible webhook or another JSON collector).
# Uncaught server errors are always emitted as redacted structured logs even when unset.
ERROR_WEBHOOK_URL=

# Email + cron automation. Keep EMAILS_ENABLED=false until dry-run output is reviewed.
CRON_SECRET=replace-with-a-long-random-secret
RESEND_API_KEY=re_...
# Existing inbound/reply-forwarding endpoint signing secret.
RESEND_WEBHOOK_SECRET=whsec_...
# Required inbox that receives verified replies forwarded by the inbound webhook.
INBOUND_FORWARD_TO=
# Separate Resend endpoint for delivered/bounced/complained events.
RESEND_DELIVERY_WEBHOOK_SECRET=whsec_...
# HMAC secret used by scanner-safe unsubscribe confirmation forms.
UNSUBSCRIBE_SIGNING_SECRET=replace-with-a-separate-long-random-secret
RESEND_FROM_EMAIL="Showcase <hello@tryshowcase.ink>"
# Required before invitation/lifecycle/digest sends. Use a valid business street address,
# registered PO box, or registered commercial mailbox; do not invent a placeholder.
EMAIL_POSTAL_ADDRESS=
EMAILS_ENABLED=false
LIFECYCLE_EMAILS_ENABLED=false
GROWTH_SCORECARD_EMAIL=
INVITE_EXCLUDE=

# Private salt for anonymous ProofScore's per-IP abuse key. Generate a long random value.
PROOFSCORE_IP_HASH_SALT=

# Optional local distribution helpers. Buffer sync creates Ideas only; partner scripts
# generate review packets and never contact anyone.
BUFFER_API_KEY=
BUFFER_ORGANIZATION_ID=
FOUNDER_NAME=

# Pre-launch lockdown — unset or anything other than "true" means ONLY /waitlist (+ legal
# pages) is reachable; everything else redirects there. Set to true on launch day.
LAUNCH_OPEN=false

# Gemini second-layer review (optional, independent reviewer/fallback — never the primary
# generator). Every value below defaults to fully disabled; do not flip AI_REVIEW_MODE or
# GEMINI_PRIVATE_DATA_ENABLED until the privacy/legal checklist in the prompt-quality system's
# Phase 10 is actually satisfied (paid billing project, ToS compliance, under-18 disclosure
# review) — flipping the env var alone does not satisfy those requirements.
GEMINI_API_KEY=
GEMINI_MODEL_REVIEWER=
# off | shadow | review | fallback
AI_REVIEW_MODE=off
# 0-1, fraction of eligible requests sampled in shadow mode
AI_REVIEW_SAMPLE_RATE=0
# comma-separated PromptSpec ids eligible for review, e.g. portfolio-generation,tailor-application
AI_REVIEW_TASKS=
AI_MAX_REVISION_PASSES=1
GEMINI_PRIVATE_DATA_ENABLED=false

# Interview Lab — Gemini legal/age/privacy gate (see security/INTERVIEW_LAB_GATE.md).
# Every flag below defaults to fully disabled. Flipping GEMINI_PAID_PROJECT_CONFIRMED and
# GEMINI_INTERVIEW_ENABLED to true is a HUMAN decision that requires: paid Cloud billing on
# the Gemini project, a review of current Gemini API terms, Showcase's Privacy Policy listing
# Google as a subprocessor, and the 18+ age gate / consent flow being live. Do not flip these
# because the code is deployed — the code being deployed is necessary, not sufficient.
GEMINI_ANALYSIS_MODEL=gemini-3.5-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_PAID_PROJECT_CONFIRMED=false
GEMINI_INTERVIEW_ENABLED=false
# Separate from GEMINI_PAID_PROJECT_CONFIRMED on purpose — "billing is paid" and "we
# reviewed current Gemini terms for this audience/use case" are two independently
# revocable facts, not one bundled checkbox.
GEMINI_TERMS_COMPATIBILITY_CONFIRMED=false
# Platform-wide emergency stop. true disables every Gemini-calling Interview Lab
# feature immediately, independent of the attestation flags above.
# Keep true until the separate Interview Lab $1/day + $20/month path uses atomic global
# reservations and passes staging concurrency tests. General runPrompt traffic is already
# guarded independently by the $4/day + $80/month reservation ledger above.
INTERVIEW_KILL_SWITCH=true
INTERVIEW_LIVE_ENABLED=false
INTERVIEW_ANALYSIS_ENABLED=false
INTERVIEW_RECORDING_ENABLED=false
INTERVIEW_RAW_AUDIO_RETENTION=false
INTERVIEW_MAX_SESSION_MINUTES=20
INTERVIEW_MAX_CONCURRENT_SESSIONS=1
INTERVIEW_MAX_RECONNECTS=3
INTERVIEW_MAX_FOLLOW_UPS=5
# USD per day/month — leave unset (not "0") to mean "no budget configured, deny all
# cost-incurring calls" rather than "unlimited."
INTERVIEW_GLOBAL_DAILY_BUDGET_USD=1
INTERVIEW_GLOBAL_MONTHLY_BUDGET_USD=20
INTERVIEW_USER_MONTHLY_BUDGET_USD=
